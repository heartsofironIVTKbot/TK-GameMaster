# On Apollo, do not create this file. Add these names on the Variables tab.
# The panel values are used first. A `.env` file is only for running the bot
# on a PC. Never commit `.env`.

# Discord Developer Portal → your application → Bot → Reset Token
DISCORD_BOT_TOKEN=

# Required. The server this process treats as home (Casino add-ons, AI log
# tools). Every server, home included, is set up on the website. A staging bot
# must use its own test server id.
HOME_GUILD_ID=

# Same database the website uses.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=hoi4_dashboard
# MYSQL_SSL_DISABLED=true
# Hosted MySQL (e.g. Aiven): the provider's CA certificate, either as a file
# name next to the bot (e.g. ca.pem) or as the PEM text itself. Encrypts the
# connection and checks the server.
# MYSQL_SSL_CA=

# Public website address. Map links and host links are built from this.
BASE_URL=http://localhost:3000
# HOST_CALENDAR_URL=http://localhost:3000/schedule

# Optional. Without it, AI chat-log grading stays off and everything else works.
# GENAI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# Optional Discord webhook for host logs. Without it, logs go to the log channel.
# HOST_LOG_WEBHOOK_URL=

# Optional. IronLegion Steam authentication (servers and games turn it on in
# their settings). A read-only login to IronLegion's database, which IronLegion
# gives you; GameMaster reads only which role IronLegion gives authenticated members
# on each server and its authentication channel. Without it nothing is locked.
# IRONLEGION_DB_HOST=
# IRONLEGION_DB_PORT=3306
# IRONLEGION_DB_USER=
# IRONLEGION_DB_PASSWORD=
# IRONLEGION_DB_NAME=
# The database's CA certificate (file name or PEM text), like MYSQL_SSL_CA.
# IRONLEGION_DB_SSL_CA=
# IRONLEGION_DB_SSL_DISABLED=false

# Ticket transcripts. Turn Message Content Intent on in the Developer Portal
# BEFORE setting this to 1, or Discord will refuse the login.
# MESSAGE_CONTENT_INTENT=0
