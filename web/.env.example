# Local MySQL connection for the web app (same database the Discord bot uses).
# Copy this file to `.env.local` and adjust for your machine. `.env.local` is
# gitignored and should never be committed.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=hoi4_dashboard

# Optional. Defaults to "true" (no TLS), matching the bot's default. Set to
# "false" to enable TLS; certificate verification is skipped for hosted MySQL.
# MYSQL_SSL_DISABLED=true

# The bot's home Discord server: the same id as the bot's HOME_GUILD_ID.
# DISCORD_GUILD_ID=

# Discord login (Discord Developer Portal → your app → OAuth2). The redirect
# URI must also be added there, e.g. https://your-site/api/auth/callback.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Any long random string — encrypts the login cookie.
# SESSION_SECRET=

# Host calendar preview: with `npm run dev` ONLY, set to 1 to try /schedule
# with sample games and a simulated bot (no database or Discord login).
# Ignored in production builds.
# SCHEDULER_DEMO=1
